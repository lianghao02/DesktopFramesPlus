<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <BinaryDir Condition="'$(BinaryDir)' == ''">../../dist/DesktopFramesPlus</BinaryDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Desktop Frames"><HintPath>$(BinaryDir)/Desktop Frames.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(BinaryDir)/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>

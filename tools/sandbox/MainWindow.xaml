<Window x:Class="FarmFenceSandbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="農場圍籬沙盒驗證"
        Width="440" Height="360"
        Left="200" Top="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    <Border x:Name="FenceBorder"
            Margin="6"
            CornerRadius="10"
            Background="#40203045"
            BorderBrush="#906585A6"
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Opacity="0.4" ShadowDepth="2" Direction="270" Color="#000000"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 標題列 (不可穿透，支援拖曳) -->
            <Border Grid.Row="0"
                    x:Name="TitleBar"
                    Background="#CC1E293B"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️ 農場圍籬沙盒 (原地分組驗證)" 
                                   Foreground="#F1F5F9" 
                                   FontWeight="SemiBold" 
                                   FontSize="13"/>
                        <TextBlock x:Name="TxtStatusBadge" 
                                   Text=" [就緒]" 
                                   Foreground="#38BDF8" 
                                   FontSize="12" 
                                   Margin="6,0,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" 
                            Content="✕" 
                            Width="26" Height="22" 
                            Background="Transparent" 
                            Foreground="#CBD5E1" 
                            BorderThickness="0" 
                            FontWeight="Bold"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 控制列 (不可穿透) -->
            <Border Grid.Row="1" Background="#EE0F172A" Padding="8,6" x:Name="ControlBar">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnScan" 
                            Content="🔍 掃描桌面項目" 
                            Padding="8,4" Margin="3,0"
                            Background="#334155" Foreground="#F8FAFC" BorderBrush="#475569"
                            Click="BtnScan_Click"/>
                    <Button x:Name="BtnArrange" 
                            Content="🧲 將原圖示吸附進圍籬" 
                            Padding="8,4" Margin="3,0"
                            Background="#0284C7" Foreground="#FFFFFF" BorderBrush="#0369A1"
                            FontWeight="SemiBold"
                            Click="BtnArrange_Click"/>
                    <Button x:Name="BtnReset" 
                            Content="↺ 還原初始位置" 
                            Padding="8,4" Margin="3,0"
                            Background="#475569" Foreground="#F8FAFC" BorderBrush="#64748B"
                            Click="BtnReset_Click"/>
                </StackPanel>
            </Border>

            <!-- 圍籬客戶區 (穿透區：滑鼠右鍵/點擊/框選直接穿透至桌面圖示) -->
            <Border Grid.Row="2" x:Name="ClientArea" Background="Transparent">
                <Grid>
                    <!-- 提示文字 (僅在未加入時提示，穿透) -->
                    <TextBlock x:Name="TxtClientHint"
                               Text="【圍籬穿透區】&#x0a;原桌面圖示可直接在此區域顯示與操作。&#x0a;點擊『吸附』即可將選定的原圖示排入本框。&#x0a;右鍵、框選、點擊直接由 Windows 處理！"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="#A0CBD5E1"
                               FontSize="12"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- 狀態列 (不可穿透) -->
            <Border Grid.Row="3" Background="#EE0F172A" Padding="8,4" CornerRadius="0,0,8,8">
                <TextBlock x:Name="TxtLog" 
                           Text="等待指令..." 
                           Foreground="#94A3B8" 
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="FarmFenceSandbox.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="農場柵欄最小操作原型控制台" Height="360" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🌾 農場柵欄最小操作原型 (Farm Fence Sandbox)" 
                       FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="• 原生桌面圖示＋穿透外框模式：原生點擊、雙擊、右鍵完全保留。" 
                       FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
            <TextBlock Text="• 原檔路徑不變，不複製、不刪除、不移至螢幕外。請手動拖曳桌面圖示進出柵欄測試。" 
                       FontSize="11" Foreground="#059669" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6">
            <TextBox x:Name="TxtLogs" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                     FontFamily="Consolas, Microsoft JhengHei UI" FontSize="11"
                     BorderThickness="0" Background="Transparent" TextWrapping="Wrap"/>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="BtnAddFence" Content="➕ 新增柵欄" Width="100" Height="28" DockPanel.Dock="Left" Click="BtnAddFence_Click" Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClearLog" Content="清除日誌" Width="90" Height="28" Margin="0,0,8,0" Click="BtnClearLog_Click"/>
                <Button x:Name="BtnExit" Content="結束原型測試" Width="100" Height="28" FontWeight="SemiBold" Click="BtnExit_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

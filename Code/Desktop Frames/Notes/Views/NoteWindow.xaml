<Window x:Class="Desktop_Frames.Notes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="便箋"
        Width="300" Height="240"
        MinWidth="180" MinHeight="140"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Border x:Name="MainBorder" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Thin Header Bar -->
            <Border x:Name="HeaderBorder" Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <!-- Right Actions StackPanel -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                        <!-- Pin (Topmost) Button -->
                        <Button x:Name="PinButton" Width="24" Height="22"
                                ToolTip="永遠置頂"
                                Click="PinButton_Click"
                                Style="{DynamicResource HeaderButtonStyle}"
                                Content="📌" FontSize="11" Opacity="0.5"/>

                        <!-- More Menu Button -->
                        <Button x:Name="MoreButton" Width="24" Height="22"
                                ToolTip="選項"
                                Click="MoreButton_Click"
                                Style="{DynamicResource HeaderButtonStyle}"
                                Content="⋯" FontSize="13" FontWeight="Bold"/>

                        <!-- Close (Hide) Button -->
                        <Button x:Name="CloseButton" Width="24" Height="22"
                                ToolTip="隱藏便箋"
                                Click="CloseButton_Click"
                                Style="{DynamicResource HeaderButtonStyle}"
                                Content="✕" FontSize="11"/>
                    </StackPanel>

                    <!-- Drag Area Spacer -->
                    <TextBlock x:Name="DragAreaTitle" Text="" VerticalAlignment="Center" Margin="8,0,0,0"
                               IsHitTestVisible="False" Foreground="#757575" FontSize="11"/>
                </DockPanel>
            </Border>

            <!-- Note Content -->
            <TextBox x:Name="ContentTextBox" Grid.Row="1"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0"
                     Margin="6,4,6,6"
                     Padding="2"
                     FontSize="13"
                     FontFamily="Segoe UI, Microsoft JhengHei, PingFang TC"
                     TextChanged="ContentTextBox_TextChanged"/>
        </Grid>
    </Border>

    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
